<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="returnsentry_pending_erasures" xsi:type="string">ReturnSentry\Connector\Model\System\PendingErasures</item>
                <item name="returnsentry_refund_control" xsi:type="string">ReturnSentry\Connector\Model\System\RefundControlAlert</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Payment\Model\MethodList">
        <plugin name="returnsentry_restrict_payment_methods" disabled="true"/>
    </type>
</config>
